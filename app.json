{
  "expo": {
    "name": "Tavlan",
    "slug": "departures-board-widget",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "tavlan",
    "userInterfaceStyle": "automatic",
    "ios": {
      "icon": "./assets/expo.icon"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.anonymous.tavlan"
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#0B0730",
          "android": {
            "image": "./assets/images/splash-icon.png",
            "imageWidth": 250
          }
        }
      ],
      [
        "./plugins/withWidgetMinResizeHeight",
        {
          "widgets": {
            "ClassicBoard": "70dp",
            "ModernBoard": "70dp"
          }
        }
      ],
      [
        "react-native-android-widget",
        {
          "fonts": [
            "./assets/fonts/Jersey10-Regular.ttf",
            "./assets/fonts/slgothicdisplay-bold.0.ttf"
          ],
          "widgets": [
            {
              "name": "ClassicBoard",
              "label": "SL - Classic Departures Board",
              "minWidth": "320dp",
              "minHeight": "70dp",
              "maxResizeHeight": "216dp",
              "targetCellWidth": 4,
              "targetCellHeight": 2,
              "description": "A Classic SL Departures Board",
              "previewImage": "./assets/images/sl_classic.png",
              "updatePeriodMillis": 1800000,
              "resizeMode": "vertical"
            },
            {
              "name": "ModernBoard",
              "label": "SL - Modern Departures Board",
              "minWidth": "320dp",
              "minHeight": "70dp",
              "maxResizeHeight": "216dp",
              "targetCellWidth": 4,
              "targetCellHeight": 2,
              "description": "A Modern SL Departures Board",
              "previewImage": "./assets/images/sl_modern.png",
              "updatePeriodMillis": 1800000,
              "resizeMode": "vertical"
            }
          ]
        }
      ],
      "expo-sqlite"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "7bbd059a-280c-484e-abf6-c6822ffcdb41"
      }
    },
    "owner": "pavlos_spn"
  }
}
