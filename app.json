{
  "expo": {
    "name": "departures-board-widget",
    "slug": "departures-board-widget",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "departuresboardwidget",
    "userInterfaceStyle": "automatic",
    "ios": {
      "icon": "./assets/expo.icon"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.anonymous.departuresboardwidget"
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#208AEF",
          "android": {
            "image": "./assets/images/splash-icon.png",
            "imageWidth": 76
          }
        }
      ],
      [
        "react-native-android-widget",
        {
          "fonts": [
            "./assets/fonts/Jersey10-Regular.ttf",
            "./assets/fonts/slgothicdisplay-bold.0.ttf"
          ],
          "widgets": [
            {
              "name": "ClassicBoard",
              "label": "Classic Departures Board",
              "minWidth": "320dp",
              "minHeight": "60dp",
              "targetCellWidth": 4,
              "targetCellHeight": 1,
              "description": "A Classic Departures Board",
              "previewImage": "./assets/images/icon.png",
              "updatePeriodMillis": 20000
            },
            {
              "name": "ModernBoard",
              "label": "Modern Departures Board",
              "minWidth": "320dp",
              "minHeight": "100dp",
              "targetCellWidth": 4,
              "targetCellHeight": 1,
              "description": "A Modern Departures Board",
              "previewImage": "./assets/images/icon.png",
              "updatePeriodMillis": 20000
            }
          ]
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    }
  }
}
